{
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(ng serve:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -c \"[Console]::Beep(800, 500)\""
          }
        ]
      }
    ]
  }
}